@model KabirHostelCare.Models.Complaint

@{
    ViewData["Title"] = "Submit Complaint";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>New Complaint | KabirHostelCare</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            background: #f3f6fc;
            font-family: Arial, sans-serif;
            color: #172033;
        }

        .topbar {
            background: #111c35;
            color: white;
            padding: 18px 28px;
        }

        .form-card {
            max-width: 850px;
            margin: 35px auto;
            background: white;
            border-radius: 18px;
            padding: 30px;
            box-shadow: 0 8px 30px rgba(20, 40, 80, .07);
        }

        .form-control, .form-select {
            padding: 11px;
            border-radius: 9px;
        }

        .form-label {
            font-weight: 600;
        }

        .btn-submit {
            background: #2459d3;
            color: white;
            padding: 12px 22px;
            border-radius: 9px;
            font-weight: 600;
        }

        .btn-submit:hover {
            background: #1e40af;
            color: white;
        }
    </style>
</head>

<body>
    <header class="topbar">
        <div class="container d-flex justify-content-between align-items-center">
            <strong>⌂ KabirHostelCare</strong>
            <a href="/Student" class="text-white text-decoration-none">
                ← Dashboard
            </a>
        </div>
    </header>

    <main class="container">
        <div class="form-card">
            <h2 class="fw-bold mb-2">Submit a Complaint</h2>
            <p class="text-secondary mb-4">
                Tell us about the problem in your hostel.
            </p>

            <form method="post" action="/Complaint/Create">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="All"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label class="form-label">Student Name</label>
                    <input class="form-control"
                           value="@ViewBag.StudentName"
                           readonly />
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Room Number</label>
                        <input asp-for="RoomNumber"
                               class="form-control"
                               placeholder="e.g. A-204"
                               maxlength="20"
                               required />
                        <span asp-validation-for="RoomNumber"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Department</label>
                        <input asp-for="Department"
                               class="form-control"
                               placeholder="e.g. Computer Engineering"
                               maxlength="100"
                               required />
                        <span asp-validation-for="Department"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Hostel Wing</label>
                        <select asp-for="Wing" class="form-select" required>
                            <option value="">Select wing</option>
                            <option value="A Wing">A Wing</option>
                            <option value="B Wing">B Wing</option>
                            <option value="C Wing">C Wing</option>
                            <option value="D Wing">D Wing</option>
                            <option value="Other">Other</option>
                        </select>
                        <span asp-validation-for="Wing"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Complaint Category</label>
                        <select asp-for="Category" class="form-select" required>
                            <option value="">Select category</option>
                            <option value="Electricity">Electricity</option>
                            <option value="Plumbing">Plumbing / Water</option>
                            <option value="Cleanliness">Cleanliness</option>
                            <option value="Furniture">Furniture</option>
                            <option value="Internet">Internet / Wi-Fi</option>
                            <option value="Maintenance">General Maintenance</option>
                            <option value="Other">Other</option>
                        </select>
                        <span asp-validation-for="Category"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Problem Title</label>
                        <input asp-for="ProblemTitle"
                               class="form-control"
                               placeholder="Briefly describe the issue"
                               maxlength="150"
                               required />
                        <span asp-validation-for="ProblemTitle"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="5"
                                  maxlength="1000"
                                  placeholder="Explain the problem in detail..."
                                  required></textarea>
                        <span asp-validation-for="Description"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="submit" class="btn btn-submit">
                        Submit Complaint
                    </button>
                    <a href="/Student"
                       class="btn btn-outline-secondary px-4 py-2">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </main>
</body>
</html>