@model KabirHostelCare.Models.Complaint

@{
    ViewData["Title"] = "Manage Complaint";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Manage Complaint | KabirHostelCare</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            background: #f3f6fc;
            font-family: Arial, sans-serif;
            color: #172033;
        }

        .topbar {
            background: #111c35;
            color: white;
            padding: 18px 25px;
        }

        .manage-card {
            max-width: 850px;
            margin: 35px auto;
            padding: 30px;
            background: white;
            border-radius: 18px;
            box-shadow: 0 8px 30px rgba(20, 40, 80, .07);
        }

        .detail-box {
            background: #f5f7fb;
            padding: 15px;
            border-radius: 10px;
            height: 100%;
        }

        .form-control, .form-select {
            padding: 11px;
            border-radius: 9px;
        }

        .form-label {
            font-weight: 600;
        }

        .btn-save {
            background: #2459d3;
            color: white;
            padding: 11px 22px;
            border-radius: 9px;
        }

        .btn-save:hover {
            background: #1e40af;
            color: white;
        }
    </style>
</head>

<body>
    <header class="topbar">
        <div class="container d-flex justify-content-between align-items-center">
            <strong>⌂ KabirHostelCare — Warden</strong>
            <a href="/Admin" class="text-white text-decoration-none">
                ← Dashboard
            </a>
        </div>
    </header>

    <main class="container">
        <div class="manage-card">
            <h2 class="fw-bold">Manage Complaint #@Model.Id</h2>
            <p class="text-secondary mb-4">
                Review the problem and update its progress.
            </p>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="detail-box">
                        <div class="text-secondary small">Student Name</div>
                        <strong>@Model.StudentName</strong>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="detail-box">
                        <div class="text-secondary small">Room / Wing</div>
                        <strong>@Model.RoomNumber / @Model.Wing</strong>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="detail-box">
                        <div class="text-secondary small">Department</div>
                        <strong>@Model.Department</strong>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="detail-box">
                        <div class="text-secondary small">Category</div>
                        <strong>@Model.Category</strong>
                    </div>
                </div>

                <div class="col-12">
                    <div class="detail-box">
                        <div class="text-secondary small">Problem Title</div>
                        <strong>@Model.ProblemTitle</strong>
                        <hr />
                        <div class="text-secondary small">Description</div>
                        <p class="mb-0" style="white-space: pre-wrap;">@Model.Description</p>
                    </div>
                </div>
            </div>

            <form method="post" action="/Admin/Manage/@Model.Id">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label">Complaint Status</label>
                    <select name="Status" class="form-select" required>
                        <option value="Submitted"
                                selected="@(Model.Status == "Submitted")">
                            Submitted
                        </option>
                        <option value="Under Review"
                                selected="@(Model.Status == "Under Review")">
                            Under Review
                        </option>
                        <option value="In Progress"
                                selected="@(Model.Status == "In Progress")">
                            In Progress
                        </option>
                        <option value="Resolved"
                                selected="@(Model.Status == "Resolved")">
                            Resolved
                        </option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Warden Remarks</label>
                    <textarea name="WardenRemarks"
                              class="form-control"
                              rows="4"
                              maxlength="1000"
                              placeholder="Add an update for the student...">@Model.WardenRemarks</textarea>
                </div>

                <div class="mb-4">
                    <label class="form-label">Expected Resolution Date</label>
                    <input type="date"
                           name="ExpectedResolutionDate"
                           class="form-control"
                           value="@(Model.ExpectedResolutionDate?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-save">
                        Save Updates
                    </button>

                    <a href="/Admin"
                       class="btn btn-outline-secondary px-4 py-2">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </main>
</body>
</html>