@model List<KabirHostelCare.Models.Complaint>

@{
    ViewData["Title"] = "Warden Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KabirHostelCare | Warden Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            background: #f3f6fc;
            font-family: Arial, sans-serif;
            color: #172033;
        }

        .sidebar {
            min-height: 100vh;
            background: #111c35;
            color: white;
            padding: 28px 18px;
        }

        .brand {
            font-size: 21px;
            font-weight: 700;
            margin-bottom: 35px;
        }

        .nav-link {
            color: #cbd5e1;
            padding: 12px;
            border-radius: 9px;
            margin-bottom: 7px;
        }

        .nav-link.active,
        .nav-link:hover {
            background: #263a61;
            color: white;
        }

        .main-content {
            padding: 30px;
        }

        .stat-card {
            background: white;
            border: 0;
            border-radius: 15px;
            padding: 22px;
            height: 100%;
            box-shadow: 0 4px 18px rgba(20, 40, 80, .05);
        }

        .stat-number {
            font-size: 30px;
            font-weight: 700;
            margin-top: 10px;
        }

        .content-card {
            background: white;
            border-radius: 15px;
            padding: 22px;
            box-shadow: 0 4px 18px rgba(20, 40, 80, .05);
        }

        .table th {
            white-space: nowrap;
            color: #526078;
            font-size: 13px;
        }

        .table td {
            vertical-align: middle;
        }

        .status {
            display: inline-block;
            padding: 6px 10px;
            border-radius: 20px;
            background: #e8eef9;
            font-size: 12px;
            font-weight: 600;
        }

        @@media (max-width: 767px) {
            .sidebar { min-height: auto; }
            .main-content { padding: 18px 12px; }
        }
    </style>
</head>

<body>
<div class="container-fluid">
    <div class="row">
        <aside class="col-md-3 col-lg-2 sidebar">
            <div class="brand">⌂ HostelCare</div>

            <div class="text-secondary small mb-3">WARDEN PANEL</div>

            <nav class="nav flex-column">
                <a class="nav-link active" href="/Admin">Dashboard</a>
                <a class="nav-link" href="/Admin">All Complaints</a>
                <form method="post" action="/Account/Logout">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="nav-link w-100 text-start border-0"
                            style="background:transparent;">
                        Logout
                    </button>
                </form>
            </nav>
        </aside>

        <main class="col-md-9 col-lg-10 main-content">
            <div class="mb-4">
                <h2 class="fw-bold">Warden Dashboard</h2>
                <p class="text-secondary mb-0">
                    Monitor and manage hostel complaints.
                </p>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-6 col-xl-3">
                    <div class="stat-card">
                        <div class="text-secondary">Total Complaints</div>
                        <div class="stat-number">@ViewBag.TotalComplaints</div>
                    </div>
                </div>

                <div class="col-6 col-xl-3">
                    <div class="stat-card">
                        <div class="text-secondary">Pending</div>
                        <div class="stat-number text-warning">@ViewBag.PendingComplaints</div>
                    </div>
                </div>

                <div class="col-6 col-xl-3">
                    <div class="stat-card">
                        <div class="text-secondary">In Progress</div>
                        <div class="stat-number text-primary">@ViewBag.InProgressComplaints</div>
                    </div>
                </div>

                <div class="col-6 col-xl-3">
                    <div class="stat-card">
                        <div class="text-secondary">Resolved</div>
                        <div class="stat-number text-success">@ViewBag.ResolvedComplaints</div>
                    </div>
                </div>
            </div>

            <div class="content-card">
                <h5 class="fw-bold mb-3">All Student Complaints</h5>

                @if (Model.Count == 0)
                {
                    <p class="text-secondary py-4 text-center">
                        No complaints have been submitted yet.
                    </p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Student</th>
                                    <th>Room / Wing</th>
                                    <th>Category</th>
                                    <th>Problem</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var complaint in Model)
                            {
                                <tr>
                                    <td>#@complaint.Id</td>
                                    <td>@complaint.StudentName</td>
                                    <td>@complaint.RoomNumber / @complaint.Wing</td>
                                    <td>@complaint.Category</td>
                                    <td>@complaint.ProblemTitle</td>
                                    <td><span class="status">@complaint.Status</span></td>
                                    <td>
                                        <a class="btn btn-sm btn-primary"
                                           href="/Admin/Manage/@complaint.Id">
                                            Manage
                                        </a>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </main>
    </div>
</div>
</body>
</html>