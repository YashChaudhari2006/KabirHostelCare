@{
    ViewData["Title"] = "Warden Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Warden Login | KabirHostelCare</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: linear-gradient(135deg, #101828, #334155);
            font-family: Arial, sans-serif;
        }

        .login-card {
            width: 100%;
            max-width: 430px;
            background: white;
            padding: 35px;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,.25);
        }

        .form-control {
            padding: 12px;
            border-radius: 10px;
        }

        .btn-login {
            padding: 12px;
            border-radius: 10px;
            background: #172554;
            color: white;
            font-weight: 600;
        }

        .btn-login:hover {
            background: #1e40af;
            color: white;
        }
    </style>
</head>

<body>
    <div class="login-card">
        <div class="text-center mb-4">
            <div class="fs-1">🛡️</div>
            <h2 class="fw-bold">Warden Login</h2>
            <p class="text-secondary">KabirHostelCare Administration</p>
        </div>

        <form method="post" action="/Account/AdminLogin">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label fw-semibold">Admin Email</label>
                <input type="email" name="Email"
                       class="form-control"
                       placeholder="warden@example.com"
                       required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Password</label>
                <input type="password" name="Password"
                       class="form-control"
                       placeholder="Enter admin password"
                       required />
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }

            <button type="submit" class="btn btn-login w-100">
                Login as Warden
            </button>
        </form>

        <p class="text-center mt-4 mb-0">
            <a href="/Account/Login" class="text-decoration-none">
                Student Login
            </a>
        </p>
    </div>
</body>
</html>