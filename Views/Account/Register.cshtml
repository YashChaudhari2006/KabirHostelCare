@{
    ViewData["Title"] = "Student Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Register | KabirHostelCare</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #101828, #1d4ed8);
            font-family: Arial, sans-serif;
            padding: 20px;
        }

        .register-card {
            width: 100%;
            max-width: 430px;
            background: white;
            padding: 35px;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,.25);
        }

        .brand-icon {
            width: 58px;
            height: 58px;
            background: #dbeafe;
            color: #1d4ed8;
            border-radius: 16px;
            display: grid;
            place-items: center;
            font-size: 28px;
            margin: 0 auto 15px;
        }

        .form-control {
            padding: 12px;
            border-radius: 10px;
        }

        .btn-register {
            padding: 12px;
            border-radius: 10px;
            background: #1d4ed8;
            color: white;
            font-weight: 600;
        }

        .btn-register:hover {
            background: #1e40af;
            color: white;
        }
    </style>
</head>

<body>
    <div class="register-card">
        <div class="text-center mb-4">
            <div class="brand-icon">⌂</div>
            <h2 class="fw-bold">KabirHostelCare</h2>
            <p class="text-secondary">Create your student account</p>
        </div>

        <form method="post" action="/Account/Register">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label fw-semibold">Full Name</label>
                <input type="text" name="FullName"
                       class="form-control"
                       placeholder="Enter your full name"
                       maxlength="100" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Email Address</label>
                <input type="email" name="Email"
                       class="form-control"
                       placeholder="student@example.com"
                       maxlength="256" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Password</label>
                <input type="password" name="Password"
                       class="form-control"
                       placeholder="Create a password"
                       minlength="6" required />
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }

            <div asp-validation-summary="All"
                 class="text-danger small mb-3"></div>

            <button type="submit"
                    class="btn btn-register w-100">
                Create Account
            </button>
        </form>

        <p class="text-center mt-4 mb-0 text-secondary">
            Already have an account?
            <a href="/Account/Login"
               class="text-decoration-none fw-semibold">
                Login
            </a>
        </p>
    </div>
</body>
</html>