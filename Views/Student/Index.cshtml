@model List<KabirHostelCare.Models.Complaint>

@{
    ViewData["Title"] = "Student Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KabirHostelCare | Student Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            background: #f4f7fb;
            font-family: Arial, sans-serif;
            color: #172033;
        }

        .sidebar {
            min-height: 100vh;
            background: #111c35;
            color: white;
            padding: 28px 18px;
        }

        .brand {
            font-size: 21px;
            font-weight: 700;
            margin-bottom: 35px;
        }

        .nav-link {
            color: #cbd5e1;
            padding: 12px;
            border-radius: 9px;
            margin-bottom: 7px;
        }

        .nav-link.active, .nav-link:hover {
            background: #263a61;
            color: white;
        }

        .main-content {
            padding: 32px;
        }

        .stat-card {
            background: white;
            border: 0;
            border-radius: 16px;
            padding: 22px;
            box-shadow: 0 4px 18px rgba(20, 40, 80, .05);
            height: 100%;
        }

        .stat-number {
            font-size: 30px;
            font-weight: 700;
            margin-top: 12px;
        }

        .content-card {
            background: white;
            border-radius: 16px;
            padding: 24px;
            box-shadow: 0 4px 18px rgba(20, 40, 80, .05);
        }

        .btn-primary {
            background: #2459d3;
        }

        @@media (max-width: 767px) {
            .sidebar {
                min-height: auto;
            }

            .main-content {
                padding: 20px 14px;
            }
        }
    </style>
</head>

<body>
<div class="container-fluid">
    <div class="row">
        <aside class="col-md-3 col-lg-2 sidebar">
            <div class="brand">⌂ HostelCare</div>

            <nav class="nav flex-column">
                <a class="nav-link active" href="/Student">Dashboard</a>
                <a class="nav-link" href="/Complaint/Create">New Complaint</a>
                <a class="nav-link" href="#my-complaints">My Complaints</a>
                <form method="post" action="/Account/Logout">
    @Html.AntiForgeryToken()
    <button type="submit" class="nav-link w-100 text-start border-0"
            style="background: transparent;">
        Logout
    </button>
</form>
            </nav>
        </aside>

        <main class="col-md-9 col-lg-10 main-content">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <div>
                    <h2 class="fw-bold">Student Dashboard</h2>
                    <p class="text-secondary mb-0">
                        Welcome, @ViewBag.StudentName
                    </p>
                </div>

                <a href="/Complaint/Create" class="btn btn-primary px-4 py-2">
                    + New Complaint
                </a>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-6 col-xl-3">
                    <div class="stat-card">
                        <div class="text-secondary">Total Complaints</div>
                        <div class="stat-number">@ViewBag.TotalComplaints</div>
                    </div>
                </div>

                <div class="col-6 col-xl-3">
                    <div class="stat-card">
                        <div class="text-secondary">Pending</div>
                        <div class="stat-number text-warning">@ViewBag.PendingComplaints</div>
                    </div>
                </div>

                <div class="col-6 col-xl-3">
                    <div class="stat-card">
                        <div class="text-secondary">In Progress</div>
                        <div class="stat-number text-primary">@ViewBag.InProgressComplaints</div>
                    </div>
                </div>

                <div class="col-6 col-xl-3">
                    <div class="stat-card">
                        <div class="text-secondary">Resolved</div>
                        <div class="stat-number text-success">@ViewBag.ResolvedComplaints</div>
                    </div>
                </div>
            </div>

            <div class="content-card" id="my-complaints">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">My Recent Complaints</h5>
                    <span class="text-secondary small">@Model.Count records</span>
                </div>

                @if (Model.Count == 0)
                {
                    <div class="text-center py-5">
                        <h5>No complaints yet</h5>
                        <p class="text-secondary">
                            Submit your first complaint to track its progress.
                        </p>
                        <a href="/Complaint/Create" class="btn btn-primary">
                            Submit Complaint
                        </a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Problem</th>
                                    <th>Category</th>
                                    <th>Status</th>
                                    <th>Expected Resolution</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var complaint in Model)
                            {
                                <tr>
                                    <td>#@complaint.Id</td>
                                    <td>@complaint.ProblemTitle</td>
                                    <td>@complaint.Category</td>
                                    <td>@complaint.Status</td>
                                    <td>
                                        @(complaint.ExpectedResolutionDate?.ToString("dd MMM yyyy") ?? "Not set")
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </main>
    </div>
</div>
</body>
</html>